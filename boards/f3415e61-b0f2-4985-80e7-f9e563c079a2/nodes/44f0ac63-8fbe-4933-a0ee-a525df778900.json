  "meta": {
    "type": "HTML_SCREEN",
    "pages": [
      "<div style=\"min-height:100vh;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:32px;display:flex;align-items:flex-start;justify-content:center\">\n  <div style=\"max-width:480px;width:100%;background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:28px;box-shadow:0 4px 16px rgba(0,0,0,0.06)\">\n\n    <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:4px\">\n      <span style=\"font-size:12px;color:#9ca3af\">Projects</span>\n      <span style=\"font-size:12px;color:#d1d5db\">›</span>\n      <span style=\"font-size:12px;color:#111827;font-weight:600\">Delete Mum</span>\n    </div>\n    <div style=\"font-size:20px;font-weight:700;color:#111827;margin-bottom:6px\">What deleting “Mum” changes</div>\n    <div style=\"font-size:13px;color:#6b7280;margin-bottom:22px;line-height:1.5\">These rules will be removed, and future signals that would have matched them will no longer be assigned automatically.</div>\n\n    <div style=\"margin-bottom:22px\">\n      <label style=\"display:block;font-size:11px;color:#6b7280;font-weight:700;letter-spacing:0.03em;margin-bottom:8px\">RULES THAT WILL BE DELETED (2)</label>\n      <div style=\"display:flex;flex-direction:column;gap:6px\">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 12px\">\n          <span style=\"font-size:13px;color:#374151\"><b>Mike</b> · Contact</span>\n          <span style=\"font-size:11px;color:#b91c1c;font-weight:700\">Deleted</span>\n        </div>\n        <div style=\"display:flex;align-items:center;justify-content:space-between;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 12px\">\n          <span style=\"font-size:13px;color:#374151\"><b>Mum's Chat</b> · Group</span>\n          <span style=\"font-size:11px;color:#b91c1c;font-weight:700\">Deleted</span>\n        </div>\n      </div>\n    </div>\n\n    <div style=\"margin-bottom:26px\">\n      <label style=\"display:block;font-size:11px;color:#6b7280;font-weight:700;letter-spacing:0.03em;margin-bottom:8px\">EXAMPLE: RECENT NOTIFICATIONS LIKE THESE</label>\n      <div style=\"display:flex;flex-direction:column;gap:8px\">\n        <div style=\"background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px 12px\">\n          <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:4px\">\n            <span style=\"width:18px;height:18px;border-radius:5px;background:#25d366;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:9px;font-weight:700\">W</span>\n            <span style=\"font-size:12px;font-weight:700;color:#111827\">Mike</span>\n            <span style=\"font-size:10px;color:#9ca3af\">WhatsApp</span>\n          </div>\n          <div style=\"font-size:12px;color:#374151;margin-bottom:6px\">“Can you call Mum later, she's not feeling great”</div>\n          <div style=\"font-size:11px;color:#9ca3af\">Would go to: <span style=\"color:#be185d;font-weight:700\">2M Mum</span> → <span style=\"color:#b91c1c;font-weight:700\">Unassigned</span></div>\n        </div>\n        <div style=\"background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px 12px\">\n          <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:4px\">\n            <span style=\"width:18px;height:18px;border-radius:5px;background:#25d366;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:9px;font-weight:700\">W</span>\n            <span style=\"font-size:12px;font-weight:700;color:#111827\">Mum's Chat</span>\n            <span style=\"font-size:10px;color:#9ca3af\">WhatsApp · Group</span>\n          </div>\n          <div style=\"font-size:12px;color:#374151;margin-bottom:6px\">“Pete: I'll pop round Thursday to help with the shopping”</div>\n          <div style=\"font-size:11px;color:#9ca3af\">Would go to: <span style=\"color:#be185d;font-weight:700\">2M Mum</span> → <span style=\"color:#b91c1c;font-weight:700\">Unassigned</span></div>\n        </div>\n      </div>\n      <div style=\"font-size:11px;color:#9ca3af;margin-top:8px\">Illustrative — based on the kinds of signals these rules have matched recently. Already-delivered notifications are not affected.</div>\n    </div>\n\n    <div style=\"display:flex;gap:10px\">\n      <div style=\"flex:1;text-align:center;background:#fff;color:#374151;border:1px solid #e5e7eb;border-radius:8px;padding:11px 0;font-size:14px;font-weight:600\">Cancel</div>\n      <div style=\"flex:1;text-align:center;background:#b91c1c;color:#fff;border-radius:8px;padding:11px 0;font-size:14px;font-weight:700\">Continue to Delete</div>\n    </div>\n\n  </div>\n</div>\n"
    ],
