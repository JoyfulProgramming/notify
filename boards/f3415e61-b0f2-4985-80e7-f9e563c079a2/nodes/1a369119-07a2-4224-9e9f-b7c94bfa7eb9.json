    "pages": [
      "<div style=\"min-height:100vh;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:32px\">\n  <div style=\"max-width:680px;margin:0 auto\">\n    <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:16px\">\n      <div style=\"display:flex;align-items:center;gap:10px\">\n        <div style=\"width:36px;height:36px;border-radius:10px;background:#111827;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:16px\">N</div>\n        <div>\n          <div style=\"font-size:20px;font-weight:700;color:#111827\">Signals</div>\n          <div style=\"font-size:12px;color:#6b7280\">All signals - filter by project below</div>\n        </div>\n      </div>\n    </div>\n\n    <div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px\">\n      <span style=\"font-size:12px;font-weight:700;padding:6px 12px;border-radius:20px;background:#111827;color:#fff\">All</span>\n      <span style=\"font-size:12px;font-weight:600;padding:6px 12px;border-radius:20px;background:#fff;border:1px solid #e5e7eb;color:#6b7280\">Unassigned</span>\n      <span style=\"font-size:12px;font-weight:600;padding:6px 12px;border-radius:20px;background:#fff;border:1px solid #e5e7eb;color:#4338ca\">1W Work</span>\n      <span style=\"font-size:12px;font-weight:600;padding:6px 12px;border-radius:20px;background:#fff;border:1px solid #e5e7eb;color:#be185d\">2M Mum</span>\n      <span style=\"font-size:12px;font-weight:600;padding:6px 12px;border-radius:20px;background:#fff;border:1px solid #e5e7eb;color:#047857\">3F Friends</span>\n    </div>\n\n    <div style=\"background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:#92400e\">\n      Assigning a signal to a project creates a rule for that sender - every future signal from them follows it automatically. Already-assigned signals never change.\n    </div>\n\n    <div style=\"display:flex;flex-direction:column;gap:10px\">\n\n      <div style=\"background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:12px\">\n          <div style=\"flex:1\">\n            <div style=\"display:flex;align-items:center;gap:8px\">\n              <span style=\"width:20px;height:20px;border-radius:6px;background:#25d366;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700\">W</span>\n              <span style=\"font-size:13px;font-weight:700;color:#111827\">Mike</span>\n              <span style=\"font-size:11px;color:#9ca3af\">WhatsApp - 2 min ago</span>\n              <span style=\"background:#f3f4f6;color:#6b7280;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px\">Unassigned</span>\n            </div>\n            <div style=\"font-size:14px;color:#374151;margin-top:6px\">\"Can you call Mum later, she's not feeling great\"</div>\n          </div>\n          <div style=\"background:#111827;color:#fff;border-radius:8px;padding:8px 16px;font-size:12px;font-weight:700;white-space:nowrap\">Assign</div>\n        </div>\n      </div>\n\n      <div style=\"background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:12px\">\n          <div style=\"flex:1\">\n            <div style=\"display:flex;align-items:center;gap:8px\">\n              <span style=\"width:20px;height:20px;border-radius:6px;background:#25d366;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700\">W</span>\n              <span style=\"font-size:13px;font-weight:700;color:#111827\">Mike</span>\n              <span style=\"font-size:11px;color:#9ca3af\">WhatsApp - 1 hr ago</span>\n              <span style=\"background:#f3f4f6;color:#6b7280;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px\">Unassigned</span>\n            </div>\n            <div style=\"font-size:14px;color:#374151;margin-top:6px\">\"Might pop round to see her tomorrow too\"</div>\n          </div>\n          <div style=\"background:#111827;color:#fff;border-radius:8px;padding:8px 16px;font-size:12px;font-weight:700;white-space:nowrap\">Assign</div>\n        </div>\n      </div>\n\n      <div style=\"background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:12px\">\n          <div style=\"flex:1\">\n            <div style=\"display:flex;align-items:center;gap:8px\">\n              <span style=\"width:20px;height:20px;border-radius:6px;background:#25d366;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700\">W</span>\n              <span style=\"font-size:13px;font-weight:700;color:#111827\">Mike</span>\n              <span style=\"font-size:11px;color:#9ca3af\">WhatsApp - yesterday</span>\n              <span style=\"background:#f3f4f6;color:#6b7280;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px\">Unassigned</span>\n            </div>\n            <div style=\"font-size:14px;color:#374151;margin-top:6px\">\"Prescription's sorted, picking it up Thursday\"</div>\n          </div>\n          <div style=\"background:#111827;color:#fff;border-radius:8px;padding:8px 16px;font-size:12px;font-weight:700;white-space:nowrap\">Assign</div>\n        </div>\n      </div>\n\n      <div style=\"background:#fff;border:1px solid #e5e7eb;border-left:4px solid #047857;border-radius:10px;padding:14px 16px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:12px\">\n          <div style=\"flex:1\">\n            <div style=\"display:flex;align-items:center;gap:8px\">\n              <span style=\"width:20px;height:20px;border-radius:6px;background:#25d366;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700\">W</span>\n              <span style=\"font-size:13px;font-weight:700;color:#111827\">Dave</span>\n              <span style=\"font-size:11px;color:#9ca3af\">WhatsApp - 3 hrs ago</span>\n              <span style=\"background:#ecfdf5;color:#047857;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px\">3F Friends</span>\n            </div>\n            <div style=\"font-size:14px;color:#374151;margin-top:6px\">\"See you at the club Thursday?\"</div>\n            <div style=\"font-size:11px;color:#9ca3af;margin-top:6px\">auto-assigned - matched an existing rule</div>\n          </div>\n          <div style=\"background:#111827;color:#fff;border-radius:8px;padding:8px 16px;font-size:12px;font-weight:700;white-space:nowrap\">Assign</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n"
