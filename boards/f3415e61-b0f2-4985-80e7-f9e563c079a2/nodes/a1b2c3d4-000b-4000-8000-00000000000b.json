      "<div style=\"min-height:100vh;background:#e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:flex;align-items:flex-start;justify-content:center;padding:12px\">\n  <div style=\"width:375px;height:600px;background:#f9fafb;border-radius:36px;box-shadow:0 8px 30px rgba(0,0,0,0.15);overflow:hidden;position:relative;display:flex;flex-direction:column\">\n\n    <div style=\"flex-shrink:0;background:#fff;border-bottom:1px solid #e5e7eb;padding:10px 16px;display:flex;align-items:center;justify-content:space-between\">\n      <span style=\"font-size:15px;font-weight:700;color:#111827\">Signals</span>\n      <div style=\"background:#e5e7eb;color:#9ca3af;font-size:12px;font-weight:600;padding:6px 14px;border-radius:999px\" title=\"Select one or more signals to enable Archive\">Archive</div>\n    </div>\n\n    <div style=\"flex-shrink:0;background:#fff;border-bottom:1px solid #e5e7eb;padding:10px 16px;display:flex;align-items:center;gap:8px;font-size:12px;color:#6b7280\">\n      <span>Select:</span>\n      <span style=\"text-decoration:underline;text-decoration-color:#d1d5db\">None</span>\n      <span style=\"color:#d1d5db\">|</span>\n      <span style=\"text-decoration:underline;text-decoration-color:#d1d5db\">All</span>\n      <span style=\"color:#d1d5db\">|</span>\n      <span style=\"text-decoration:underline;text-decoration-color:#d1d5db\">Invert</span>\n    </div>\n\n    <div style=\"flex-shrink:0;background:#fff;border-bottom:1px solid #e5e7eb;padding:8px 16px;display:flex;align-items:center;gap:10px\">\n      <span style=\"font-size:11px;font-weight:600;color:#6b7280;white-space:nowrap\">Group by</span>\n      <div style=\"display:flex;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;flex:1\">\n        <div style=\"flex:1;text-align:center;padding:6px 0;font-size:12px;font-weight:700;color:#1d4ed8;background:#eff6ff;border-right:1px solid #e5e7eb\">None</div>\n        <div style=\"flex:1;text-align:center;padding:6px 0;font-size:12px;font-weight:600;color:#6b7280;background:#fff;border-right:1px solid #e5e7eb\">Contact</div>\n        <div style=\"flex:1;text-align:center;padding:6px 0;font-size:12px;font-weight:600;color:#6b7280;background:#fff\">Group</div>\n      </div>\n    </div>\n\n    <div style=\"flex:1;overflow-y:auto;display:flex;align-items:center;justify-content:center\">\n      <div style=\"text-align:center;color:#9ca3af;padding:40px 24px\">\n        <div style=\"font-size:32px;margin-bottom:10px\">✓</div>\n        <div style=\"font-size:14px;font-weight:600;color:#374151\">All caught up</div>\n        <div style=\"font-size:12px;margin-top:4px;max-width:220px\">Every signal has been archived. New signals will appear here as they come in.</div>\n      </div>\n    </div>\n\n    <div style=\"flex-shrink:0;background:#fff;border-top:1px solid #e5e7eb;padding:8px 12px\">\n      <div style=\"width:100%;text-align:center;background:#e5e7eb;color:#9ca3af;border-radius:8px;padding:11px 0;font-size:14px;font-weight:600\">Assign</div>\n    </div>\n\n  </div>\n</div>\n"
